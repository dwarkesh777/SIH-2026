# FarmVerse AI — Backend Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the .env file with real secrets.

# Django Core
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# JWT Authentication
JWT_SECRET_KEY=
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=1

# CORS (comma-separated frontend origins for production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API Keys
OPENWEATHER_API_KEY=your_openweather_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Email Service (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# SSL Redirect (set to False if behind a reverse proxy that handles SSL)
SECURE_SSL_REDIRECT=True
