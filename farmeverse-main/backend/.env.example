# FarmVerse AI — Backend Environment Variables
# NEVER commit real production secrets to Git.

# Django Core
DEBUG=False
SECRET_KEY=generate-a-strong-secret-key-for-production
# In Railway, you can set ALLOWED_HOSTS=* or your specific .railway.app domain
ALLOWED_HOSTS=*

# Database (Railway automatically sets DATABASE_URL when you add PostgreSQL service)
# DATABASE_URL=postgresql://user:password@host:port/database

# JWT Authentication
JWT_SECRET_KEY=generate-a-strong-jwt-secret-key
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS & CSRF (Set your deployed Vercel domain here)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://*.railway.app,https://*.vercel.app,https://your-frontend.vercel.app

# API Keys
OPENWEATHER_API_KEY=your_openweather_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Email Service (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# SSL Settings (Railway handles SSL termination via reverse proxy)
SECURE_SSL_REDIRECT=False
